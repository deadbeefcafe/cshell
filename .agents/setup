#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
go_version="1.25.0"
go_sha256="2852af0cb20a13139b3448992e69b868e50ed0f8a1e5940ee1de9e19a123b613"
go_root="$HOME/.local/toolchains/go${go_version}"

echo "[setup] Preparing Go ${go_version}"
step_start=$SECONDS
if [[ ! -x "$go_root/bin/go" ]] || [[ "$($go_root/bin/go version)" != "go version go${go_version} linux/amd64" ]]; then
	tmp_dir="$(mktemp -d)"
	trap 'rm -rf "$tmp_dir"' EXIT
	curl --fail --location --retry 3 --silent --show-error \
		"https://go.dev/dl/go${go_version}.linux-amd64.tar.gz" \
		--output "$tmp_dir/go.tar.gz"
	echo "$go_sha256  $tmp_dir/go.tar.gz" | sha256sum --check --status
	tar -C "$tmp_dir" -xzf "$tmp_dir/go.tar.gz"
	mkdir -p "$(dirname "$go_root")"
	rm -rf "$go_root"
	mv "$tmp_dir/go" "$go_root"
fi
mkdir -p "$HOME/.local/bin"
ln -sfn "$go_root/bin/go" "$HOME/.local/bin/go"
ln -sfn "$go_root/bin/gofmt" "$HOME/.local/bin/gofmt"
echo "[setup] Go ready in $((SECONDS - step_start))s"

echo "[setup] Downloading module dependencies"
step_start=$SECONDS
for module_dir in \
	"$repo_root" \
	"$repo_root/examples/sshd" \
	"$repo_root/examples/telnetd" \
	"$repo_root/examples/term"; do
	(cd "$module_dir" && "$go_root/bin/go" mod download)
done
echo "[setup] Dependencies ready in $((SECONDS - step_start))s"
